# SOMENTE SERVIDOR. Não use prefixos NEXT_PUBLIC_, PUBLIC_ ou VITE_.
# Copie para um arquivo privado não versionado ou para o secret store do host.
# Os valores abaixo são placeholders, não credenciais utilizáveis.
SPOTIFY_CLIENT_ID=replace_with_registered_client_id
SPOTIFY_CLIENT_SECRET=replace_with_server_only_client_secret

# Apenas CLI/backend de um único titular. Produção multiusuário usa TokenStore
# durável por grant e lock distribuído; não um refresh token compartilhado em env.
SPOTIFY_REFRESH_TOKEN=replace_with_single_owner_refresh_token

# confidential exige secret; pkce não aceita clientSecret. Ambos são server-mediated.
SPOTIFY_OAUTH_MODE=confidential

# Cadastre exatamente esta URI no Dashboard. HTTPS em produção; IP loopback no dev.
# localhost não é aceito. Não inclua code/state/error nem fragmentos na configuração.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback

# Origem confiável configurada pelo operador, não derivada de Host/query do usuário.
APP_ORIGIN=http://127.0.0.1:3000
